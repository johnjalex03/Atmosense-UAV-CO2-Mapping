# Data — keep large recordings out of git
*.bag
*.db3
*.mcap
data/raw/

# Source videos — the README embeds the generated .gif versions instead.
# These stay on disk locally but are kept out of the repo: dashboard.mov (67MB) and
# greenhouse_flight.mp4 (53MB) both exceed GitHub's 50MB warning threshold, and once
# committed they bloat every clone forever. Host full-quality video externally
# (issue-upload or YouTube) and link it from the README.
assets/demos/*.mov
assets/demos/*.mp4
# ...except these, which are small enough to keep and are linked from the README.
!assets/demos/Z2_exploded_view.mov
!assets/demos/greenhouse_flight_web.mp4

# OS / editor
.DS_Store
.vscode/
.idea/
